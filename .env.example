# ==============================================================================
# HarvestPoint Backend - Arquivo de Configuração de Ambiente para Produção (AWS)
# ==============================================================================
# Copie este arquivo para .env na raiz de Backend/ antes de iniciar o deploy:
#   cp .env.example .env
#
# Em seguida, edite com as suas credenciais reais.

# ------------------------------------------------------------------------------
# 1. Configurações Principais do Rails
# ------------------------------------------------------------------------------
RAILS_ENV=production

# Chave secreta de criptografia de sessão e cookies do Rails (OBRIGATÓRIO em produção).
# Gere uma chave segura no terminal executando:
#   openssl rand -hex 64
SECRET_KEY_BASE=c0ffeec0ffeec0ffeec0ffeec0ffeec0ffeec0ffeec0ffeec0ffeec0ffee1234567890abcdef

# Se você utiliza credentials.yml.enc, defina a chave mestra aqui (opcional se SECRET_KEY_BASE for definida):
# RAILS_MASTER_KEY=

# Nível de log: debug, info, warn, error
RAILS_LOG_LEVEL=info

# Concorrência e Threads
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# Executar as filas em segundo plano (Solid Queue) dentro do processo Puma
SOLID_QUEUE_IN_PUMA=true

# ------------------------------------------------------------------------------
# 2. Portas de Execução
# ------------------------------------------------------------------------------
# Porta interna do Puma
PORT=3000

# Porta externa mapeada no host / Thruster HTTP
APP_PORT=80

# ------------------------------------------------------------------------------
# 3. Banco de Dados PostgreSQL
# ------------------------------------------------------------------------------
# OPÇÃO A: Se estiver usando o container 'db' do docker-compose.prod.yml
DB_HOST=db
DB_PORT=5432
DB_NAME=harvestpoint_production
DB_USERNAME=harvestpoint
DB_PASSWORD=DefinaUmaSenhaForteParaOBancoAqui2026!

# OPÇÃO B: Se estiver usando AWS RDS PostgreSQL gerenciado (descomente abaixo e comente o serviço db no compose):
# DATABASE_URL=postgresql://harvestpoint:SENHA_RDS@harvestpoint-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/harvestpoint_production

# ------------------------------------------------------------------------------
# 4. CORS (Segurança de Origens Permitidas)
# ------------------------------------------------------------------------------
# Lista separada por vírgula das URLs que têm permissão de chamar a API
# Inclua o endereço do seu frontend (Vercel, S3/CloudFront, ou IP da EC2)
# Se deixado em branco, aceitará qualquer origem ("*") como fallback.
FRONTEND_ORIGINS=http://localhost:5173,http://SEU_IP_OU_DOMINIO_AWS
