# Copie este arquivo para .env no ambiente que tiver PostgreSQL.
# Não coloque valores reais no código-fonte.

# JWT_SECRET_KEY=altere-esta-chave-em-producao

# Quando o PostgreSQL estiver disponível, use uma destas opções:
# DATABASE_URL=postgres://usuario:senha@host:5432/harvestpoint_development
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=harvestpoint
# DATABASE_PASSWORD=

# Origens permitidas pelo CORS (separadas por vírgula).
# CORS_ORIGINS=http://localhost:5173
